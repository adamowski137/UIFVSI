#version 460 core

layout (isolines, fractional_even_spacing, ccw) in;
out vec2 fuv;

uniform mat4 model;
uniform mat4 view;
uniform mat4 projection;
uniform bool reverse; 

uniform uint u_subdivisions;
uniform uint v_subdivisions;
vec3 p(uint index) {
    return gl_in[index].gl_Position.xyz;
}

vec3 bezier(float t, vec3 b0, vec3 b1, vec3 b2, vec3 b3)
{
  float t1 = 1.0f - t;

  b0 = t1 * b0 + t * b1;  
  b1 = t1 * b1 + t * b2;
  b2 = t1 * b2 + t * b3;

  b0 = t1 * b0 + t * b1;
  b1 = t1 * b1 + t * b2;

	return t1 * b0 + t * b1;
}

vec3 bezierSurf(float u, float v){
  const float eps = 1e-10;
  //0, 3 bot
  //4, 5 midlow
  //6, 7 midtop
  //8, 11 top
  //12, 15 uDiv
  //16, 19 vDiv

    vec3 p00 = (p(12) * (u) + p(16) * v) / (u + v + eps);  
    vec3 p01 = (p(13) * u + p(17) * (1 - v)) / (1 + u - v + eps);
    vec3 p10 = (p(14) * (1 - u) + p(18) * v) / (1 - u + v + eps);
    vec3 p11 = (p(15) * (1 - u) + p(19) * (1 - v)) / (2 - u - v + eps);

    vec3 p0 = bezier(v, p(0), p(1), p(2), p(3));
    vec3 p1 = bezier(v, p(4), p00, p01, p(5));
    vec3 p2 = bezier(v, p(6), p10, p11, p(7));
    vec3 p3 = bezier(v, p(8), p(9), p(10), p(11));

    return bezier(u, p0, p1, p2, p3);
}

void main(){
  float u = gl_TessCoord.x;
  float v = gl_TessCoord.y;
  vec3 pos = bezierSurf(u, v);
  gl_Position = projection * view * model * vec4(pos, 1.0f);
}
